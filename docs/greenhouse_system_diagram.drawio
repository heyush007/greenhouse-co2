<mxfile host="app.diagrams.net"><diagram id="sysdiag" name="System diagram"><mxGraphModel dx="1540" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Greenhouse CO₂ controller — FreeRTOS system diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#17212B;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="RP2040 · 4 tasks + 1 optional · 2 ISRs · every peripheral has exactly one owner task, so no mutex is needed" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1300" height="22" as="geometry"/></mxCell><mxCell id="n2" value="HARDWARE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="150" height="16" as="geometry"/></mxCell><mxCell id="n3" value="ISRs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=10;" vertex="1" parent="1"><mxGeometry x="235" y="80" width="150" height="16" as="geometry"/></mxCell><mxCell id="n4" value="ISR → TASK" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="150" height="16" as="geometry"/></mxCell><mxCell id="n5" value="TASKS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="150" height="16" as="geometry"/></mxCell><mxCell id="n6" value="KERNEL OBJECTS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="80" width="150" height="16" as="geometry"/></mxCell><mxCell id="n7" value="TASKS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="150" height="16" as="geometry"/></mxCell><mxCell id="n8" value="HARDWARE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4E5B68;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1360" y="80" width="150" height="16" as="geometry"/></mxCell><mxCell id="hw_modbus" value="&lt;b style=&quot;font-size:14px&quot;&gt;Modbus RTU bus&lt;/b&gt;&lt;br&gt;UART1 · RS-485 · 9600 bps&lt;br&gt;GMP252 CO₂ · addr 240&lt;br&gt;HMP60 RH + T · addr 241&lt;br&gt;MIO 12-V fan I/O · addr 1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;AO1 fan speed 0–10 V&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;AI1 fan pulse counter&lt;br&gt;&lt;i&gt;(simulated by 2nd Pico on the mini test system)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8591;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontColor=#17212B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="180" height="170" as="geometry"/></mxCell><mxCell id="hw_enc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Rotary encoder&lt;/b&gt;&lt;br&gt;A / B / push switch&lt;br&gt;Buttons SW0–SW2&lt;br&gt;GPIO inputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8591;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontColor=#17212B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="180" height="90" as="geometry"/></mxCell><mxCell id="hw_oled" value="&lt;b style=&quot;font-size:14px&quot;&gt;OLED display&lt;/b&gt;&lt;br&gt;I2C1 (SDP610 also on I2C1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8591;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontColor=#17212B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="575" width="180" height="62" as="geometry"/></mxCell><mxCell id="hw_eeprom" value="&lt;b style=&quot;font-size:14px&quot;&gt;EEPROM&lt;/b&gt;&lt;br&gt;I2C0&lt;br&gt;setpoint + network settings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8591;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontColor=#17212B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="180" height="70" as="geometry"/></mxCell><mxCell id="hw_valve" value="&lt;b style=&quot;font-size:14px&quot;&gt;CO₂ valve relay&lt;/b&gt;&lt;br&gt;GPIO27&lt;br&gt;open ≤ 2 s at a time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8591;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontColor=#17212B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="165" height="80" as="geometry"/></mxCell><mxCell id="hw_cloud" value="&lt;b style=&quot;font-size:14px&quot;&gt;ThingSpeak cloud&lt;/b&gt;&lt;br&gt;Wi-Fi (CYW43)&lt;br&gt;HTTP / TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8591;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontColor=#17212B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="495" width="165" height="80" as="geometry"/></mxCell><mxCell id="isr_uart" value="&lt;b style=&quot;font-size:15px&quot;&gt;UART1 IRQ&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background:#A8651A;color:#fff;padding:0 6px;font-family:Courier New;font-size:11px&quot;&gt;ISR&lt;/span&gt;&lt;br&gt;PicoOsUart handler&lt;br&gt;moves bytes only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEEDD;strokeColor=#A8651A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontColor=#17212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="150" width="160" height="80" as="geometry"/></mxCell><mxCell id="isr_gpio" value="&lt;b style=&quot;font-size:15px&quot;&gt;GPIO IRQ&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background:#A8651A;color:#fff;padding:0 6px;font-family:Courier New;font-size:11px&quot;&gt;ISR&lt;/span&gt;&lt;br&gt;encoder A edge, keys&lt;br&gt;posts event only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEEDD;strokeColor=#A8651A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontColor=#17212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="470" width="160" height="80" as="geometry"/></mxCell><mxCell id="q_rxtx" value="rx / tx&lt;br&gt;&lt;span style=&quot;font-family:Helvetica;font-size:10px;color:#4E5B68&quot;&gt;CHAR QUEUES&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F1EE;strokeColor=#1D7467;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#17212B;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="420" y="162" width="140" height="56" as="geometry"/></mxCell><mxCell id="q_input" value="inputQueue&lt;br&gt;&lt;span style=&quot;font-family:Helvetica;font-size:10px;color:#4E5B68&quot;&gt;QUEUE · EVENT&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F1EE;strokeColor=#1D7467;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#17212B;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="420" y="482" width="140" height="56" as="geometry"/></mxCell><mxCell id="q_fan" value="fanCmdQueue&lt;br&gt;&lt;span style=&quot;font-family:Helvetica;font-size:10px;color:#4E5B68&quot;&gt;QUEUE · FAN %&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F1EE;strokeColor=#1D7467;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#17212B;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="860" y="125" width="180" height="56" as="geometry"/></mxCell><mxCell id="mb_sensor" value="sensorData&lt;br&gt;&lt;span style=&quot;font-family:Helvetica;font-size:10px;color:#4E5B68&quot;&gt;MAILBOX · LEN 1&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F1EE;strokeColor=#1D7467;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#17212B;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="860" y="215" width="180" height="56" as="geometry"/></mxCell><mxCell id="mb_status" value="systemStatus&lt;br&gt;&lt;span style=&quot;font-family:Helvetica;font-size:10px;color:#4E5B68&quot;&gt;MAILBOX · LEN 1&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F1EE;strokeColor=#1D7467;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#17212B;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="860" y="330" width="180" height="56" as="geometry"/></mxCell><mxCell id="q_sp" value="setpointQueue&lt;br&gt;&lt;span style=&quot;font-family:Helvetica;font-size:10px;color:#4E5B68&quot;&gt;QUEUE · PPM&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F1EE;strokeColor=#1D7467;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#17212B;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1140" y="330" width="180" height="56" as="geometry"/></mxCell><mxCell id="q_save" value="saveQueue&lt;br&gt;&lt;span style=&quot;font-family:Helvetica;font-size:10px;color:#4E5B68&quot;&gt;QUEUE · SETTINGS&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F1EE;strokeColor=#1D7467;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#17212B;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="860" y="720" width="180" height="56" as="geometry"/></mxCell><mxCell id="t_modbus" value="&lt;b style=&quot;font-size:15px&quot;&gt;Modbus task&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background:#2B5C8A;color:#fff;border-radius:8px;padding:0 6px;font-family:Courier New;font-size:11px&quot;&gt;P3&lt;/span&gt;&lt;br&gt;Sole owner of UART1 bus&lt;br&gt;Every 2 s reads:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;CO₂ (240), RH + T (241)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fan pulse count (MIO 1)&lt;br&gt;Writes fan speed to AO1&lt;br&gt;Detects fan stopped" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#2B5C8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontColor=#17212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="110" width="230" height="170" as="geometry"/></mxCell><mxCell id="t_control" value="&lt;b style=&quot;font-size:15px&quot;&gt;Control task&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background:#2B5C8A;color:#fff;border-radius:8px;padding:0 6px;font-family:Courier New;font-size:11px&quot;&gt;P4&lt;/span&gt;&lt;br&gt;Runs every 1 s (vTaskDelayUntil)&lt;br&gt;CO₂ &amp;lt; SP: valve open 1 s,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;then hold ≥ 30 s&lt;br&gt;CO₂ &amp;gt; 2000 ppm: fan 100 %&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;until back at SP&lt;br&gt;Sole owner of GPIO27 valve" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#2B5C8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontColor=#17212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="240" height="170" as="geometry"/></mxCell><mxCell id="t_ui" value="&lt;b style=&quot;font-size:15px&quot;&gt;UI task&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background:#2B5C8A;color:#fff;border-radius:8px;padding:0 6px;font-family:Courier New;font-size:11px&quot;&gt;P2&lt;/span&gt;&lt;br&gt;Blocks on inputQueue&lt;br&gt;Draws CO₂, RH, T, fan %, SP&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;on OLED (owns I2C1)&lt;br&gt;Encoder edits SP (≤ 1500)&lt;br&gt;Sends new SP + save&lt;br&gt;Redraws every 500 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#2B5C8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontColor=#17212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="450" width="230" height="170" as="geometry"/></mxCell><mxCell id="t_net" value="&lt;b style=&quot;font-size:15px&quot;&gt;Network task&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background:#2B5C8A;color:#fff;border-radius:8px;padding:0 6px;font-family:Courier New;font-size:11px&quot;&gt;P1&lt;/span&gt;&lt;br&gt;OPTIONAL (advanced feature)&lt;br&gt;Wi-Fi + ThingSpeak POST&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;field1–5 every 30 s&lt;br&gt;TalkBack command → new SP&lt;br&gt;Sends new SP + save" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#2B5C8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontColor=#17212B;fontSize=12;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1080" y="450" width="240" height="170" as="geometry"/></mxCell><mxCell id="t_store" value="&lt;b style=&quot;font-size:15px&quot;&gt;Storage task&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background:#2B5C8A;color:#fff;border-radius:8px;padding:0 6px;font-family:Courier New;font-size:11px&quot;&gt;P1&lt;/span&gt;&lt;br&gt;Sole owner of I2C0 EEPROM&lt;br&gt;Blocks on saveQueue,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;writes settings&lt;br&gt;(settings read in main() at boot)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#2B5C8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontColor=#17212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="690" width="230" height="110" as="geometry"/></mxCell><mxCell id="n9" value="RS-485" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#36424F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontFamily=Courier New;fontColor=#1D7467;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.471;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="hw_modbus" target="isr_uart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#36424F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontFamily=Courier New;fontColor=#1D7467;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="isr_uart" target="q_rxtx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#36424F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontFamily=Courier New;fontColor=#1D7467;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.471;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="q_rxtx" target="t_modbus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#36424F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontFamily=Courier New;fontColor=#1D7467;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.253;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_control" target="q_fan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="recv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#36424F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontFamily=Courier New;fontColor=#1D7467;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.253;entryDx=0;entryDy=0;" edge="1" parent="1" source="q_fan" target="t_modbus"><mxGeometry relative="1" as="geometry">