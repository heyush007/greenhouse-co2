# Template for local credentials.
# Copy this file to  secrets.cmake  (same folder) and fill in real values.
# secrets.cmake is git-ignored so your keys never get committed.
#
# Alternatively, set these as environment variables instead of using this file.
set(WIFI_SSID               "MP-IOT")
set(WIFI_PASSWORD           "your-wifi-password")

set(THINGSPEAK_HOST         "api.thingspeak.com")
set(THINGSPEAK_API_KEY      "your-channel-write-api-key")
set(THINGSPEAK_TALKBACK_ID  "your-talkback-id")
set(THINGSPEAK_TALKBACK_KEY "your-talkback-api-key")
